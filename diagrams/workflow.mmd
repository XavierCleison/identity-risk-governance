sequenceDiagram
    participant User as User
    participant IdP as Identity Provider
    participant IAM as IAM Platform
    participant RE as Risk Engine
    participant LLM as LLM/AI
    participant Dashboard as Dashboard
    participant AuditLog as Audit Log

    User->>IdP: 1. Submit Credentials
    activate IdP
    IdP->>IdP: Validate Credentials
    IdP->>IAM: 2. Issue JWT Token
    deactivate IdP
    
    activate IAM
    IAM->>RE: 3. User Access Context
    deactivate IAM
    
    activate RE
    RE->>RE: 4. Check Permissions
    RE->>RE: 5. Analyze Anomalies
    RE->>RE: 6. Calculate Risk Score
    
    alt Risk Score LOW (<4)
        RE->>IAM: 7a. Low Risk - Allow
        activate IAM
        IAM->>AuditLog: Log: Access Allowed
        IAM->>IdP: Grant Access Token
        deactivate IAM
    else Risk Score MEDIUM (4-6)
        RE->>LLM: 7b. Medium Risk - Analyze
        activate LLM
        LLM->>LLM: Context Analysis
        LLM->>RE: Recommendation
        deactivate LLM
        RE->>IAM: 8. Apply Strategy
        activate IAM
        IAM->>IdP: Request MFA
        deactivate IAM
    else Risk Score HIGH (>6)
        RE->>LLM: 7c. High Risk - Deep Analysis
        activate LLM
        LLM->>LLM: Full Risk Assessment
        LLM->>RE: Escalation Recommendation
        deactivate LLM
        RE->>IAM: 8. Deny Access
        activate IAM
        IAM->>AuditLog: Log: Access Denied
        IAM->>IdP: Deny Token
        deactivate IAM
    end
    
    deactivate RE
    
    activate IdP
    IdP->>User: 9. Access Decision
    deactivate IdP
    
    activate Dashboard
    Dashboard->>Dashboard: 10. Update Risk Metrics
    Dashboard->>Dashboard: Display KPIs & Heatmap
    deactivate Dashboard

    RE->>AuditLog: 11. Final Audit Trail
    
    activate AuditLog
    AuditLog->>Dashboard: 12. Compliance Report
    deactivate AuditLog
