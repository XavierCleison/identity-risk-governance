graph TB
    subgraph Users["User Interaction"]
        U["User"]
        E["Applications"]
    end

    subgraph Identity["Identity & Authentication"]
        IDP["Identity Provider<br/>(SAML/OAuth/OIDC)"]
        MFA["MFA Service"]
        AUT["Authentication Layer"]
    end

    subgraph IAM["IAM Platform"]
        UP["User Management"]
        RM["Role Management"]
        PM["Permission Management"]
        AC["Access Control"]
    end

    subgraph Risk["Risk Management"]
        RE["Risk Engine"]
        AM["Anomaly Detection"]
        RR["Risk Register"]
    end

    subgraph AI["AI/LLM Analysis"]
        LLMM["LLM Orchestration"]
        PROMPT["Prompt Engineering"]
        VAL["Validation Layer"]
    end

    subgraph Storage["Data & Storage"]
        PG["PostgreSQL"]
        RD["Redis Cache"]
        LOG["Audit Logs"]
    end

    subgraph Presentation["Presentation Layer"]
        DASH["Dashboard"]
        API["REST APIs"]
        REPORT["Reports"]
    end

    U -->|Login| IDP
    IDP -->|MFA Challenge| MFA
    MFA -->|JWT Token| AUT
    AUT -->|Verify| UP
    E -->|Access Request| AC

    UP -->|User Data| RE
    RM -->|Role Data| RE
    PM -->|Permissions| RE
    AC -->|Events| RE

    RE -->|Analyze| AM
    AM -->|Risk Score| RR
    RR -->|Risk Context| LLMM

    LLMM -->|Generate| PROMPT
    PROMPT -->|LLM Call| VAL
    VAL -->|Validated Output| RE

    RE -->|Store| PG
    RE -->|Cache| RD
    RE -->|Log Events| LOG

    RR -->|Data| DASH
    RE -->|API| API
    PG -->|Data| REPORT

    DASH -->|Dashboard| U
    REPORT -->|Output| DASH
    
    style Users fill:#e1f5ff,stroke:#01579b
    style Identity fill:#f3e5f5,stroke:#4a148c
    style IAM fill:#e8f5e9,stroke:#1b5e20
    style Risk fill:#fff3e0,stroke:#e65100
    style AI fill:#fce4ec,stroke:#880e4f
    style Storage fill:#f1f8e9,stroke:#33691e
    style Presentation fill:#ede7f6,stroke:#311b92
