graph LR
    subgraph Origins["Fonte de identidade e contexto"]
        U["Identidades / usuários"]
        P["Perfis, papéis e permissões"]
        ORG["Dados organizacionais e de processo"]
    end

    subgraph IAM["Governança IAM"]
        CMP["IAM Platform / catálogo de acessos"]
        POL["Políticas e regras de governança"]
    end

    subgraph Risk["Análise de risco"]
        RE["Risk Engine"]
        DET["Detecção de risco"]
        EVI["Registro de evidências"]
    end

    subgraph AI["Apoio analítico com IA"]
        LLM["IA Generativa"]
        REC["Recomendações"]
    end

    subgraph Governance["Decisão e auditoria"]
        HUM["Responsável humano autorizado"]
        AUD["Histórico e auditoria"]
    end

    subgraph Pres["Apresentação e governança"]
        DASH["Dashboard e relatórios"]
    end

    U --> CMP
    P --> CMP
    ORG --> RE
    CMP --> RE
    RE --> DET
    DET --> EVI
    EVI --> LLM
    LLM --> REC
    REC --> HUM
    HUM --> AUD
    RE --> AUD
    CMP --> AUD
    AUD --> DASH
    DASH --> HUM
    CMP --> POL
    POL --> RE

    style Origins fill:#e3f2fd,stroke:#1565c0
    style IAM fill:#e8f5e9,stroke:#2e7d32
    style Risk fill:#fff3e0,stroke:#ef6c00
    style AI fill:#fce4ec,stroke:#ad1457
    style Governance fill:#f3e5f5,stroke:#6a1b9a
    style Pres fill:#ede7f6,stroke:#4527a0
